    npm install          # (already succeeded)
    npm run build        # should now pass TypeScript checking# MySQL connection string for the default local XAMPP installation.
# If your XAMPP root user has a password, include it after `root:`.
DATABASE_URL="mysql://root@127.0.0.1:3306/tourneyup_v2"

# Absolute site URL — used for metadataBase, OG images and sitemap.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Show the demo-credentials hint on /login (never set this in production).
NEXT_PUBLIC_SHOW_DEMO_LOGINS="true"

# Separate database for `npm run test` integration tests. Tests write
# throw-away rows into it — never point it at real data.
DATABASE_URL_TEST="mysql://root@127.0.0.1:3306/tourneyup_test"
